<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="mainVBox" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="798.0" prefWidth="828.0" spacing="10" style="-fx-background-color: #F9F9F9; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.storefx.AddNewCustomerPageController">
   <children>
      <!-- Nagłówek -->
      <Label alignment="CENTER" style="-fx-text-fill: #333333; -fx-font-family: 'Unispace'; -fx-font-size: 28px; -fx-alignment: CENTER;" text="Tworzenie nowego użytkownika" />

      <!-- Formularz -->
      <VBox alignment="TOP_LEFT" spacing="20">
         <children>
            <!-- Dane logowania -->
            <VBox spacing="10">
               <Label style="-fx-font-size: 18px; -fx-text-fill: #4A4A4A; -fx-font-family: 'Unispace';" text="Dane logowania:" />
               <GridPane hgap="10" vgap="10">
                  <children>
                     <Label text="Login:" />
                     <TextField fx:id="userName" prefWidth="240.0" GridPane.columnIndex="1" />

                     <Label text="Hasło:" GridPane.rowIndex="1" />
                     <PasswordField fx:id="UserPassword" prefWidth="240.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  </children>
                  <columnConstraints>
                     <ColumnConstraints />
                     <ColumnConstraints />
                  </columnConstraints>
                  <rowConstraints>
                     <RowConstraints />
                     <RowConstraints />
                  </rowConstraints>
               </GridPane>
            </VBox>

            <!-- Separator -->
            <Separator />

            <!-- Dane osobowe -->
            <VBox spacing="10">
               <Label style="-fx-font-size: 18px; -fx-text-fill: #4A4A4A; -fx-font-family: 'Unispace';" text="Twoje dane:" />
               <GridPane hgap="10" vgap="10">
                  <children>
                     <Label text="Imię:" />
                     <TextField fx:id="Name" prefWidth="240.0" GridPane.columnIndex="1" />

                     <Label text="Nazwisko:" GridPane.rowIndex="1" />
                     <TextField fx:id="Surname" prefWidth="240.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                     <Label text="Adres e-mail:" GridPane.rowIndex="2" />
                     <TextField fx:id="Email" prefWidth="240.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                     <Label text="Nr telefonu:" GridPane.rowIndex="3" />
                     <TextField fx:id="PhoneNumber" prefWidth="240.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  </children>
                  <columnConstraints>
                     <ColumnConstraints />
                     <ColumnConstraints />
                  </columnConstraints>
                  <rowConstraints>
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                  </rowConstraints>
               </GridPane>
            </VBox>

            <!-- Separator -->
            <Separator />

            <!-- Dane adresowe -->
            <VBox spacing="10">
               <Label style="-fx-font-size: 18px; -fx-text-fill: #4A4A4A; -fx-font-family: 'Unispace';" text="Twoje dane adresowe:" />
               <GridPane hgap="10" vgap="10">
                  <children>
                     <Label text="Kraj:" />
                     <TextField fx:id="Country" prefWidth="240.0" GridPane.columnIndex="1" />

                     <Label text="Miasto:" GridPane.rowIndex="1" />
                     <TextField fx:id="City" prefWidth="240.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                     <Label text="Ulica:" GridPane.rowIndex="2" />
                     <TextField fx:id="Street" prefWidth="240.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                     <Label text="Nr domu/mieszkania:" GridPane.rowIndex="3" />
                     <TextField fx:id="NumberOnStreet" prefWidth="240.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                     <Label text="Kod pocztowy:" GridPane.rowIndex="4" />
                     <TextField fx:id="PostalCode" prefWidth="240.0" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                  </children>
                  <columnConstraints>
                     <ColumnConstraints />
                     <ColumnConstraints />
                  </columnConstraints>
                  <rowConstraints>
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                  </rowConstraints>
               </GridPane>
            </VBox>

            <!-- Separator -->
            <Separator />

            <!-- Zgody -->
            <VBox spacing="10">
               <CheckBox fx:id="RegulaminCheckBox" text="Oświadczam, że zapoznałem się z regulaminem sklepu" />
               <CheckBox fx:id="ZgodaCheckBox" text="Wyrażam zgodę na przetwarzanie moich danych osobowych" />
            </VBox>
         </children>
      </VBox>

      <!-- Przyciski -->
      <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20 0 0 0;">
         <children>
            <Button fx:id="CreateAccountButton" onAction="#onCreateAccountButton" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-family: 'Unispace'; -fx-font-weight: bold;" text="Utwórz konto" />
            <Button fx:id="CancelCreatingAccountButton" onAction="#onCancelCreatingButton" style="-fx-background-color: #F44336; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-family: 'Unispace'; -fx-font-weight: bold;" text="Anuluj" />
         </children>
      </HBox>
   </children>
</VBox>
