<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="482.0" prefWidth="835.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.storefx.CartPageController">
    <VBox prefHeight="434.0" prefWidth="788.0" spacing="10" AnchorPane.bottomAnchor="-44.0" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">
        <!-- Nagłówek -->
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Twój koszyk" />
      <ScrollPane prefHeight="314.0" prefWidth="815.0">
         <content>
            <VBox fx:id="cartVbox" prefHeight="312.0" prefWidth="803.0">
               <children>
                  <AnchorPane prefHeight="167.0" prefWidth="803.0">
                     <children>
                        <ImageView fitHeight="143.0" fitWidth="146.0" layoutX="21.0" layoutY="9.0" pickOnBounds="true" preserveRatio="true" />
                        <Label layoutX="180.0" layoutY="23.0" text="Nazwa produktu" />
                        <Label layoutX="180.0" layoutY="64.0" text="Ilość" />
                        <Label layoutX="178.0" layoutY="108.0" text="Cena" />
                        <TextField layoutX="311.0" layoutY="19.0" />
                        <TextField layoutX="311.0" layoutY="60.0" />
                        <TextField layoutX="311.0" layoutY="104.0" />
                        <Button layoutX="681.0" layoutY="129.0" mnemonicParsing="false" text="Usuń z koszyka" />
                        <Button layoutX="479.0" layoutY="60.0" mnemonicParsing="false" text="+" />
                        <Button layoutX="513.0" layoutY="60.0" mnemonicParsing="false" text="-" />
                     </children>
                  </AnchorPane>
               </children>
            </VBox>
         </content>
      </ScrollPane>

        <!-- Sekcja podsumowania -->
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Label style="-fx-font-size: 16px;" text="Łączna kwota:" />
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="0.00 PLN" />
        </HBox>

        <!-- Przycisk finalizacji -->
        <Button fx:id="goToOrder" maxWidth="Infinity" onAction="#goToOrder" prefHeight="47.0" prefWidth="604.0" style="-fx-font-size: 16px; -fx-background-color: #28a745; -fx-text-fill: white;" text="Zamów i zapłać przy odbiorze" />
    </VBox>
</AnchorPane>
