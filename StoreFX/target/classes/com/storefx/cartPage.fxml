<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="808.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.storefx.CartPageController">
    <VBox spacing="10" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">
        <!-- Nagłówek -->
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Twój koszyk" />

        <!-- Lista produktów -->
        <ListView prefHeight="300" />

        <!-- Sekcja podsumowania -->
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Label style="-fx-font-size: 16px;" text="Łączna kwota:" />
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="0.00 PLN" />
        </HBox>

        <!-- Przycisk finalizacji -->
        <Button maxWidth="Infinity" prefHeight="47.0" prefWidth="604.0" style="-fx-font-size: 16px; -fx-background-color: #28a745; -fx-text-fill: white;" text="Przejdź do płatności" />
    </VBox>
</AnchorPane>
